{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/ficha-tecnica",
      "destination": "/ficha-tecnica/index.html"
    },
    {
      "source": "/ficha-tecnica/",
      "destination": "/ficha-tecnica/index.html"
    },
    {
      "source": "/((?!ficha-tecnica).*)",
      "destination": "/index.html"
    }
  ]
}
